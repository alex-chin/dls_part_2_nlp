    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"initial_id\",\n",
    "   \"metadata\": {\n",
    "    \"collapsed\": true,\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-12-15T20:27:37.883852800Z\",\n",
    "     \"start_time\": \"2025-12-15T20:27:37.855486300Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import socket\\n\",\n",
    "    \"\\n\",\n",
    "    \"def send_cp1251_message_with_response(message_text, host='localhost', port=5999, timeout=5, buffer_size=1024):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Отправляет строку в cp1251 и возвращает ответ от сервера\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Параметры:\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    message_text : str\\n\",\n",
    "    \"        Строка для отправки\\n\",\n",
    "    \"    host : str, optional\\n\",\n",
    "    \"        Адрес сервера\\n\",\n",
    "    \"    port : int, optional\\n\",\n",
    "    \"        Порт сервера\\n\",\n",
    "    \"    timeout : int, optional\\n\",\n",
    "    \"        Таймаут ожидания ответа в секундах\\n\",\n",
    "    \"    buffer_size : int, optional\\n\",\n",
    "    \"        Размер буфера для приема данных\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Возвращает:\\n\",\n",
    "    \"    -----------\\n\",\n",
    "    \"    tuple (bool, str)\\n\",\n",
    "    \"        (успех отправки, ответ от сервера или сообщение об ошибке)\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\\n\",\n",
    "    \"    client_socket.settimeout(timeout)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        # Подключаемся к серверу\\n\",\n",
    "    \"        client_socket.connect((host, port))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Отправляем сообщение\\n\",\n",
    "    \"        client_socket.send(message_text.encode('cp1251'))\\n\",\n",
    "    \"        print(f\\\"Отправлено: {message_text}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Получаем ответ\\n\",\n",
    "    \"        response = client_socket.recv(buffer_size)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if response:\\n\",\n",
    "    \"            # Пытаемся декодировать ответ как cp1251\\n\",\n",
    "    \"            try:\\n\",\n",
    "    \"                decoded_response = response.decode('cp1251')\\n\",\n",
    "    \"                return True, decoded_response\\n\",\n",
    "    \"            except UnicodeDecodeError:\\n\",\n",
    "    \"                # Если не получается декодировать как cp1251, возвращаем сырые байты как строку\\n\",\n",
    "    \"                return True, f\\\"[Бинарные данные: {response}]\\\"\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            return True, \\\"[Сервер не отправил ответ]\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    except socket.timeout:\\n\",\n",
    "    \"        return False, \\\"Таймаут ожидания ответа\\\"\\n\",\n",
    "    \"    except ConnectionRefusedError:\\n\",\n",
    "    \"        return False, f\\\"Сервер {host}:{port} недоступен\\\"\\n\",\n",
    "    \"    except UnicodeEncodeError:\\n\",\n",
    "    \"        return False, \\\"Ошибка кодирования строки в cp1251\\\"\\n\",\n",
    "    \"    except socket.error as e:\\n\",\n",
    "    \"        return False, f\\\"Ошибка сети: {e}\\\"\\n\",\n",
    "    \"    except Exception as e:\\n\",\n",
    "    \"        return False, f\\\"Неизвестная ошибка: {e}\\\"\\n\",\n",
    "    \"    finally:\\n\",\n",
    "    \"        client_socket.close()\\n\"\n",
    "   ],\n",
