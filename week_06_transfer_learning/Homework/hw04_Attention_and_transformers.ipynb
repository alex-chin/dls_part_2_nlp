    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# Создаем полный отчет по классификации\\n\",\n",
    "    \"def create_classification_report(model, data_loader, id_to_topic, model_name=\\\"Model\\\"):\\n\",\n",
    "    \"    print(f\\\"\\\\n{'=' * 80}\\\")\\n\",\n",
    "    \"    print(f\\\"ОТЧЕТ ПО КЛАССИФИКАЦИИ: {model_name}\\\")\\n\",\n",
    "    \"    print(f\\\"{'=' * 80}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Получаем предсказания\\n\",\n",
    "    \"    true_labels, pred_labels, probabilities = get_predictions(model, data_loader, id_to_topic)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 1. Classification Report от sklearn\\n\",\n",
    "    \"    print(\\\"\\\\n1. ДЕТАЛИЗИРОВАННЫЙ ОТЧЕТ ПО КЛАССАМ:\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 50)\\n\",\n",
    "    \"    report = classification_report(true_labels, pred_labels, output_dict=False)\\n\",\n",
    "    \"    print(report)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 2. Accuracy\\n\",\n",
    "    \"    accuracy = accuracy_score(true_labels, pred_labels)\\n\",\n",
    "    \"    print(f\\\"\\\\n2. ОБЩАЯ ТОЧНОСТЬ: {accuracy:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 3. Confusion Matrix\\n\",\n",
    "    \"    print(f\\\"\\\\n3. МАТРИЦА ОШИБОК:\\\")\\n\",\n",
    "    \"    cm = confusion_matrix(true_labels, pred_labels, labels=list(id_to_topic.values()))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.figure(figsize=(8, 6))\\n\",\n",
    "    \"    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\\n\",\n",
    "    \"                xticklabels=id_to_topic.values(),\\n\",\n",
    "    \"                yticklabels=id_to_topic.values())\\n\",\n",
    "    \"    plt.title(f'Confusion Matrix - {model_name}')\\n\",\n",
    "    \"    plt.xlabel('Предсказанные метки')\\n\",\n",
    "    \"    plt.ylabel('Истинные метки')\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 4. Статистика по классам\\n\",\n",
    "    \"    print(f\\\"\\\\n4. СТАТИСТИКА ПО КЛАССАМ:\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 40)\\n\",\n",
    "    \"    unique_true = np.unique(true_labels, return_counts=True)\\n\",\n",
    "    \"    unique_pred = np.unique(pred_labels, return_counts=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"Распределение истинных меток:\\\")\\n\",\n",
    "    \"    for topic, count in zip(unique_true[0], unique_true[1]):\\n\",\n",
    "    \"        print(f\\\"  {topic}: {count} примеров\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"\\\\nРаспределение предсказанных меток:\\\")\\n\",\n",
    "    \"    for topic, count in zip(unique_pred[0], unique_pred[1]):\\n\",\n",
    "    \"        print(f\\\"  {topic}: {count} примеров\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 5. Детальный анализ ошибок\\n\",\n",
    "    \"    print(f\\\"\\\\n5. АНАЛИЗ ОШИБОК:\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 40)\\n\",\n",
    "    \"    errors = []\\n\",\n",
    "    \"    for i, (true, pred) in enumerate(zip(true_labels, pred_labels)):\\n\",\n",
    "    \"        if true != pred:\\n\",\n",
    "    \"            errors.append({\\n\",\n",
    "    \"                'index': i,\\n\",\n",
    "    \"                'true': true,\\n\",\n",
    "    \"                'predicted': pred,\\n\",\n",
    "    \"                'confidence': max(probabilities[i])\\n\",\n",
    "    \"            })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if errors:\\n\",\n",
    "    \"        print(f\\\"Всего ошибок: {len(errors)}\\\")\\n\",\n",
    "    \"        print(\\\"\\\\nПримеры ошибок (первые 5):\\\")\\n\",\n",
    "    \"        for error in errors[:5]:\\n\",\n",
    "    \"            print(f\\\"  Пример {error['index']}: {error['true']} → {error['predicted']} \\\"\\n\",\n",
    "    \"                  f\\\"(уверенность: {error['confidence']:.4f})\\\")\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        print(\\\"Ошибок не обнаружено!\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 6. Метрики в виде DataFrame для удобства\\n\",\n",
    "    \"    report_dict = classification_report(true_labels, pred_labels, output_dict=True)\\n\",\n",
    "    \"    metrics_df = pd.DataFrame(report_dict).transpose()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
