    "    \"id\": \"zRi7tkoOAjon\"\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"### Задание 5 (1 балл)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Обучите *tbs17/MathBert* (с замороженным backbone и без заморозки), проанализируйте результаты. Сравните скоры с первым заданием. Получилось лучше или нет? Почему?\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"id\": \"XKtd3YgNA14E\",\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-11-01T14:39:38.037472Z\",\n",
    "     \"start_time\": \"2025-11-01T11:39:45.246875Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from torch.utils.data import DataLoader, Dataset\\n\",\n",
    "    \"from transformers import AutoTokenizer\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Кастомный датасет для наших данных\\n\",\n",
    "    \"class ProblemsDataset(Dataset):\\n\",\n",
    "    \"    def __init__(self, texts, labels, tokenizer, max_length=128):\\n\",\n",
    "    \"        self.texts = texts\\n\",\n",
    "    \"        self.labels = labels\\n\",\n",
    "    \"        self.tokenizer = tokenizer\\n\",\n",
    "    \"        self.max_length = max_length\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __len__(self):\\n\",\n",
    "    \"        return len(self.texts)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __getitem__(self, idx):\\n\",\n",
    "    \"        text = str(self.texts[idx])\\n\",\n",
    "    \"        label = self.labels[idx]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Токенизация текста\\n\",\n",
    "    \"        encoding = self.tokenizer(\\n\",\n",
    "    \"            text,\\n\",\n",
    "    \"            truncation=True,\\n\",\n",
    "    \"            padding='max_length',\\n\",\n",
    "    \"            max_length=self.max_length,\\n\",\n",
    "    \"            return_tensors='pt'\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return {\\n\",\n",
    "    \"            'input_ids': encoding['input_ids'].flatten(),\\n\",\n",
    "    \"            'attention_mask': encoding['attention_mask'].flatten(),\\n\",\n",
    "    \"            'labels': torch.tensor(label, dtype=torch.long)\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Загрузка и подготовка данных\\n\",\n",
    "    \"def prepare_data(file_path=\\\"data_problems_translated.csv\\\"):\\n\",\n",
    "    \"    # Загружаем данные\\n\",\n",
    "    \"    df = pd.read_csv(file_path, sep=';')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Преобразуем topics в числовые метки\\n\",\n",
    "    \"    topics = df['topic'].unique()\\n\",\n",
    "    \"    topic_to_id = {topic: i for i, topic in enumerate(topics)}\\n\",\n",
    "    \"    id_to_topic = {i: topic for topic, i in topic_to_id.items()}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"Темы в датасете:\\\")\\n\",\n",
    "    \"    for topic, topic_id in topic_to_id.items():\\n\",\n",
    "    \"        print(f\\\"  {topic}: {topic_id}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Создаем тексты и метки\\n\",\n",
    "    \"    texts = df['problem_text'].tolist()\\n\",\n",
    "    \"    labels = [topic_to_id[topic] for topic in df['topic']]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Статистика\\n\",\n",
    "    \"    print(f\\\"\\\\nСтатистика датасета:\\\")\\n\",\n",
    "    \"    print(f\\\"Всего примеров: {len(df)}\\\")\\n\",\n",
    "    \"    print(f\\\"Распределение по темам:\\\")\\n\",\n",
    "    \"    for topic, topic_id in topic_to_id.items():\\n\",\n",
    "    \"        count = sum(1 for label in labels if label == topic_id)\\n\",\n",
    "    \"        print(f\\\"  {topic}: {count} примеров\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return texts, labels, topic_to_id, id_to_topic\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Проверка функции дообучения на реальном датасете с MathBert\\n\",\n",
    "    \"print(\\\"Загружаем и подготавливаем данные...\\\")\\n\",\n",
    "    \"texts, labels, topic_to_id, id_to_topic = prepare_data(\\\"data_problems_translated.csv\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Инициализируем токенизатор для MathBert\\n\",\n",
    "    \"tokenizer = AutoTokenizer.from_pretrained(\\\"tbs17/MathBert\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Создаем датасет и разделяем на train/val\\n\",\n",
    "    \"dataset = ProblemsDataset(texts, labels, tokenizer)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Разделяем данные на тренировочные и валидационные (80/20)\\n\",\n",
    "    \"train_size = int(0.8 * len(dataset))\\n\",\n",
    "    \"val_size = len(dataset) - train_size\\n\",\n",
    "    \"train_dataset, val_dataset = torch.utils.data.random_split(\\n\",\n",
    "    \"    dataset, [train_size, val_size],\\n\",\n",
    "    \"    generator=torch.Generator().manual_seed(42)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"train_loader = DataLoader(train_dataset, batch_size=8, shuffle=True)\\n\",\n",
    "    \"val_loader = DataLoader(val_dataset, batch_size=8, shuffle=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\nРазмеры датасетов:\\\")\\n\",\n",
    "    \"print(f\\\"Тренировочный: {len(train_dataset)} примеров\\\")\\n\",\n",
    "    \"print(f\\\"Валидационный: {len(val_dataset)} примеров\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 60)\\n\",\n",
    "    \"print(\\\"ДООБУЧЕНИЕ MATHBERT С ЗАМОРОЖЕННЫМ BACKBONE\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 60)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Первый способ: дообучение с замороженным backbone\\n\",\n",
    "    \"mathbert_model_1 = TransformerClassificationModel(\\n\",\n",
    "    \"    \\\"tbs17/MathBert\\\",  # ИЗМЕНЕНИЕ: используем MathBert вместо rubert-tiny2\\n\",\n",
    "    \"    num_labels=len(topic_to_id)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"mathbert_finetuned_with_freezed_backbone = train_transformer(\\n\",\n",
    "    \"    mathbert_model_1,\\n\",\n",
    "    \"    freeze_backbone=True,\\n\",\n",
    "    \"    train_loader=train_loader,\\n\",\n",
    "    \"    val_loader=val_loader,\\n\",\n",
    "    \"    num_epochs=5,\\n\",\n",
    "    \"    learning_rate=2e-4,\\n\",\n",
    "    \"    warmup_steps=20\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 60)\\n\",\n",
    "    \"print(\\\"ДООБУЧЕНИЕ MATHBERT С РАЗМОРОЖЕННЫМ BACKBONE\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 60)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Второй способ: дообучение с размороженным backbone\\n\",\n",
    "    \"mathbert_model_2 = TransformerClassificationModel(\\n\",\n",
    "    \"    \\\"tbs17/MathBert\\\",  # ИЗМЕНЕНИЕ: используем MathBert вместо rubert-tiny2\\n\",\n",
    "    \"    num_labels=len(topic_to_id)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"mathbert_full_finetuned = train_transformer(\\n\",\n",
    "    \"    mathbert_model_2,\\n\",\n",
    "    \"    freeze_backbone=False,\\n\",\n",
    "    \"    train_loader=train_loader,\\n\",\n",
    "    \"    val_loader=val_loader,\\n\",\n",
    "    \"    num_epochs=5,\\n\",\n",
    "    \"    learning_rate=2e-5,\\n\",\n",
    "    \"    warmup_steps=20\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 60)\\n\",\n",
    "    \"print(\\\"ФИНАЛЬНОЕ ТЕСТИРОВАНИЕ НА ВАЛИДАЦИИ\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 60)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Функция для оценки точности\\n\",\n",
    "    \"def evaluate_final_model(model, val_loader, id_to_topic):\\n\",\n",
    "    \"    model.eval()\\n\",\n",
    "    \"    correct = 0\\n\",\n",
    "    \"    total = 0\\n\",\n",
    "    \"    all_predictions = []\\n\",\n",
    "    \"    all_true_labels = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    with torch.no_grad():\\n\",\n",
    "    \"        for batch in val_loader:\\n\",\n",
    "    \"            inputs = {k: v for k, v in batch.items() if k != 'labels'}\\n\",\n",
    "    \"            labels = batch['labels']\\n\",\n",
    "    \"\\n\",\n",
    "    \"            outputs = model(inputs)\\n\",\n",
    "    \"            logits = outputs['logits']\\n\",\n",
    "    \"            predictions = torch.argmax(logits, dim=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            correct += (predictions == labels).sum().item()\\n\",\n",
    "    \"            total += labels.size(0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            all_predictions.extend(predictions.cpu().tolist())\\n\",\n",
    "    \"            all_true_labels.extend(labels.cpu().tolist())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    accuracy = correct / total\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Детальная информация по классам\\n\",\n",
    "    \"    print(f\\\"Точность на валидации: {accuracy:.4f}\\\")\\n\",\n",
    "    \"    print(\\\"\\\\nДетали по темам:\\\")\\n\",\n",
    "    \"    for topic_id, topic_name in id_to_topic.items():\\n\",\n",
    "    \"        topic_correct = sum(1 for pred, true in zip(all_predictions, all_true_labels)\\n\",\n",
    "    \"                            if true == topic_id and pred == true)\\n\",\n",
    "    \"        topic_total = sum(1 for true in all_true_labels if true == topic_id)\\n\",\n",
    "    \"        if topic_total > 0:\\n\",\n",
    "    \"            topic_acc = topic_correct / topic_total\\n\",\n",
    "    \"            print(f\\\"  {topic_name}: {topic_correct}/{topic_total} ({topic_acc:.4f})\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return accuracy\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"MathBert с замороженным backbone:\\\")\\n\",\n",
    "    \"frozen_accuracy = evaluate_final_model(\\n\",\n",
    "    \"    mathbert_finetuned_with_freezed_backbone,\\n\",\n",
    "    \"    val_loader,\\n\",\n",
    "    \"    id_to_topic\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nMathBert с размороженным backbone:\\\")\\n\",\n",
    "    \"full_accuracy = evaluate_final_model(\\n\",\n",
    "    \"    mathbert_full_finetuned,\\n\",\n",
    "    \"    val_loader,\\n\",\n",
    "    \"    id_to_topic\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 60)\\n\",\n",
    "    \"print(\\\"СРАВНЕНИЕ РЕЗУЛЬТАТОВ MATHBERT\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 60)\\n\",\n",
    "    \"print(f\\\"Точность с замороженным backbone: {frozen_accuracy:.4f}\\\")\\n\",\n",
    "    \"print(f\\\"Точность с размороженным backbone: {full_accuracy:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Тестирование на нескольких примерах\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 60)\\n\",\n",
    "    \"print(\\\"ТЕСТИРОВАНИЕ НА КОНКРЕТНЫХ ПРИМЕРАХ\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 60)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Берем несколько примеров из валидации\\n\",\n",
    "    \"test_examples = []\\n\",\n",
    "    \"for i in range(min(3, len(val_dataset))):\\n\",\n",
    "    \"    example = val_dataset[i]\\n\",\n",
    "    \"    text = texts[train_size + i]\\n\",\n",
    "    \"    true_topic_id = labels[train_size + i]\\n\",\n",
    "    \"    true_topic = id_to_topic[true_topic_id]\\n\",\n",
    "    \"    test_examples.append((text, true_topic))\\n\",\n",
    "    \"\\n\",\n",
    "    \"mathbert_finetuned_with_freezed_backbone.eval()\\n\",\n",
    "    \"mathbert_full_finetuned.eval()\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i, (text, true_topic) in enumerate(test_examples):\\n\",\n",
    "    \"    print(f\\\"\\\\nПример {i + 1}:\\\")\\n\",\n",
    "    \"    print(f\\\"Текст: {text[:100]}...\\\")\\n\",\n",
    "    \"    print(f\\\"Истинная тема: {true_topic}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Токенизация\\n\",\n",
    "    \"    encoding = tokenizer(\\n\",\n",
    "    \"        text,\\n\",\n",
    "    \"        truncation=True,\\n\",\n",
    "    \"        padding='max_length',\\n\",\n",
    "    \"        max_length=128,\\n\",\n",
    "    \"        return_tensors='pt'\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    with torch.no_grad():\\n\",\n",
    "    \"        # Предсказание первой модели\\n\",\n",
    "    \"        outputs1 = mathbert_finetuned_with_freezed_backbone(encoding)\\n\",\n",
    "    \"        logits1 = outputs1['logits']\\n\",\n",
    "    \"        probs1 = torch.softmax(logits1, dim=1)\\n\",\n",
    "    \"        pred1_id = torch.argmax(probs1, dim=1).item()\\n\",\n",
    "    \"        pred1_topic = id_to_topic[pred1_id]\\n\",\n",
    "    \"        pred1_conf = probs1[0][pred1_id].item()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Предсказание второй модели\\n\",\n",
    "    \"        outputs2 = mathbert_full_finetuned(encoding)\\n\",\n",
    "    \"        logits2 = outputs2['logits']\\n\",\n",
    "    \"        probs2 = torch.softmax(logits2, dim=1)\\n\",\n",
    "    \"        pred2_id = torch.argmax(probs2, dim=1).item()\\n\",\n",
    "    \"        pred2_topic = id_to_topic[pred2_id]\\n\",\n",
    "    \"        pred2_conf = probs2[0][pred2_id].item()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"MathBert с замороженным backbone: {pred1_topic} (уверенность: {pred1_conf:.4f})\\\")\\n\",\n",
    "    \"    print(f\\\"MathBert с размороженным backbone: {pred2_topic} (уверенность: {pred2_conf:.4f})\\\")\\n\",\n",
    "    \"    print(f\\\"Совпадение с истиной: {pred1_topic == true_topic}/{pred2_topic == true_topic}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n✅ Тестирование MathBert завершено!\\\")\"\n",
    "   ],\n",
