    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# Сравнительный отчет двух моделей\\n\",\n",
    "    \"def create_comparison_report(model1, model2, data_loader, id_to_topic,\\n\",\n",
    "    \"                             model1_name=\\\"Модель 1\\\", model2_name=\\\"Модель 2\\\"):\\n\",\n",
    "    \"    print(f\\\"\\\\n{'=' * 80}\\\")\\n\",\n",
    "    \"    print(f\\\"СРАВНИТЕЛЬНЫЙ ОТЧЕТ\\\")\\n\",\n",
    "    \"    print(f\\\"{'=' * 80}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Получаем результаты для обеих моделей\\n\",\n",
    "    \"    results1 = create_classification_report(model1, data_loader, id_to_topic, model1_name)\\n\",\n",
    "    \"    results2 = create_classification_report(model2, data_loader, id_to_topic, model2_name)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"\\\\n6. СРАВНЕНИЕ МОДЕЛЕЙ:\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 50)\\n\",\n",
    "    \"    print(f\\\"{'Метрика':<20} {model1_name:<25} {model2_name:<25}\\\")\\n\",\n",
    "    \"    print(\\\"-\\\" * 70)\\n\",\n",
    "    \"    print(f\\\"{'Accuracy':<20} {results1['accuracy']:<25.4f} {results2['accuracy']:<25.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Сравнение precision, recall, f1 для каждого класса\\n\",\n",
    "    \"    for topic in id_to_topic.values():\\n\",\n",
    "    \"        if topic in results1['classification_report']:\\n\",\n",
    "    \"            prec1 = results1['classification_report'][topic]['precision']\\n\",\n",
    "    \"            prec2 = results2['classification_report'][topic]['precision']\\n\",\n",
    "    \"            rec1 = results1['classification_report'][topic]['recall']\\n\",\n",
    "    \"            rec2 = results2['classification_report'][topic]['recall']\\n\",\n",
    "    \"            f11 = results1['classification_report'][topic]['f1-score']\\n\",\n",
    "    \"            f12 = results2['classification_report'][topic]['f1-score']\\n\",\n",
    "    \"\\n\",\n",
    "    \"            print(f\\\"{topic + ' Precision':<20} {prec1:<25.4f} {prec2:<25.4f}\\\")\\n\",\n",
    "    \"            print(f\\\"{topic + ' Recall':<20} {rec1:<25.4f} {rec2:<25.4f}\\\")\\n\",\n",
    "    \"            print(f\\\"{topic + ' F1-score':<20} {f11:<25.4f} {f12:<25.4f}\\\")\\n\",\n",
    "    \"            print(\\\"-\\\" * 70)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return results1, results2\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Основная функция для создания отчета по rubert-tiny2\\n\",\n",
    "    \"def create_rubert_tiny_report():\\n\",\n",
    "    \"    # Загружаем данные (аналогично предыдущему коду)\\n\",\n",
    "    \"    print(\\\"Подготовка данных для rubert-tiny2...\\\")\\n\",\n",
    "    \"    texts, labels, topic_to_id, id_to_topic = prepare_data(\\\"data_problems.xlsx\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Инициализируем токенизатор\\n\",\n",
    "    \"    tokenizer = AutoTokenizer.from_pretrained(\\\"cointegrated/rubert-tiny2\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Создаем датасет\\n\",\n",
    "    \"    dataset = ProblemsDataset(texts, labels, tokenizer)\\n\",\n",
    "    \"    train_size = int(0.8 * len(dataset))\\n\",\n",
    "    \"    val_size = len(dataset) - train_size\\n\",\n",
    "    \"    train_dataset, val_dataset = torch.utils.data.random_split(\\n\",\n",
    "    \"        dataset, [train_size, val_size],\\n\",\n",
    "    \"        generator=torch.Generator().manual_seed(42)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    val_loader = DataLoader(val_dataset, batch_size=8, shuffle=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Загружаем дообученные модели (предполагая, что они уже сохранены)\\n\",\n",
    "    \"    print(\\\"\\\\nЗагрузка моделей rubert-tiny2...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Модель с замороженным backbone\\n\",\n",
    "    \"    # rubert_tiny_frozen = TransformerClassificationModel(\\n\",\n",
    "    \"    #     \\\"cointegrated/rubert-tiny2\\\",\\n\",\n",
    "    \"    #     num_labels=len(topic_to_id)\\n\",\n",
    "    \"    # )\\n\",\n",
    "    \"    #\\n\",\n",
    "    \"    rubert_tiny_frozen=rubert_tiny_finetuned_with_freezed_backbone\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Модель с размороженным backbone\\n\",\n",
    "    \"    rubert_tiny_full = TransformerClassificationModel(\\n\",\n",
    "    \"        \\\"cointegrated/rubert-tiny2\\\",\\n\",\n",
    "    \"        num_labels=len(topic_to_id)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    rubert_tiny_full = rubert_tiny_full\\n\",\n",
    "    \"    # Здесь должны быть загружены веса дообученных моделей\\n\",\n",
    "    \"    # rubert_tiny_frozen.load_state_dict(torch.load('rubert_tiny_frozen.pth'))\\n\",\n",
    "    \"    # rubert_tiny_full.load_state_dict(torch.load('rubert_tiny_full.pth'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"Создание отчетов...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Создаем индивидуальные отчеты\\n\",\n",
    "    \"    frozen_results = create_classification_report(\\n\",\n",
    "    \"        rubert_tiny_frozen, val_loader, id_to_topic,\\n\",\n",
    "    \"        \\\"RuBert-Tiny2 (замороженный backbone)\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    full_results = create_classification_report(\\n\",\n",
    "    \"        rubert_tiny_full, val_loader, id_to_topic,\\n\",\n",
    "    \"        \\\"RuBert-Tiny2 (размороженный backbone)\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Создаем сравнительный отчет\\n\",\n",
    "    \"    comparison_results = create_comparison_report(\\n\",\n",
    "    \"        rubert_tiny_frozen, rubert_tiny_full, val_loader, id_to_topic,\\n\",\n",
    "    \"        \\\"Замороженный backbone\\\", \\\"Размороженный backbone\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Сохраняем результаты в файлы\\n\",\n",
    "    \"    frozen_results['metrics_df'].to_csv('rubert_tiny_frozen_metrics.csv')\\n\",\n",
    "    \"    full_results['metrics_df'].to_csv('rubert_tiny_full_metrics.csv')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"\\\\n✅ Отчеты сохранены в файлы:\\\")\\n\",\n",
    "    \"    print(\\\"   - rubert_tiny_frozen_metrics.csv\\\")\\n\",\n",
    "    \"    print(\\\"   - rubert_tiny_full_metrics.csv\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return frozen_results, full_results\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Дополнительная функция для визуализации\\n\",\n",
    "    \"def plot_comparison_metrics(frozen_results, full_results):\\n\",\n",
    "    \"    \\\"\\\"\\\"Визуализация сравнения метрик двух моделей\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    metrics = ['precision', 'recall', 'f1-score']\\n\",\n",
    "    \"    topics = list(frozen_results['classification_report'].keys())[:-3]  # Исключаем средние\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, axes = plt.subplots(1, 3, figsize=(15, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for idx, metric in enumerate(metrics):\\n\",\n",
    "    \"        frozen_scores = [frozen_results['classification_report'][topic][metric] for topic in topics]\\n\",\n",
    "    \"        full_scores = [full_results['classification_report'][topic][metric] for topic in topics]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        x = np.arange(len(topics))\\n\",\n",
    "    \"        width = 0.35\\n\",\n",
    "    \"\\n\",\n",
    "    \"        axes[idx].bar(x - width / 2, frozen_scores, width, label='Замороженный', alpha=0.7)\\n\",\n",
    "    \"        axes[idx].bar(x + width / 2, full_scores, width, label='Размороженный', alpha=0.7)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        axes[idx].set_xlabel('Темы')\\n\",\n",
    "    \"        axes[idx].set_ylabel(metric.capitalize())\\n\",\n",
    "    \"        axes[idx].set_title(f'Сравнение {metric}')\\n\",\n",
    "    \"        axes[idx].set_xticks(x)\\n\",\n",
    "    \"        axes[idx].set_xticklabels(topics, rotation=45)\\n\",\n",
    "    \"        axes[idx].legend()\\n\",\n",
    "    \"        axes[idx].grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Запуск создания отчетов\\n\",\n",
    "    \"if __name__ == \\\"__main__\\\":\\n\",\n",
    "    \"    frozen_results, full_results = create_rubert_tiny_report()\\n\",\n",
    "    \"    plot_comparison_metrics(frozen_results, full_results)\"\n",
    "   ],\n",
